# Cloudflare Pages headers.
#
# Two jobs: the security headers Pages does not add on its own, and one
# Cache-Control tier per class of asset. Added 2026-09-06 after the
# pre-release sweep found the file held a single graph rule (QA F6-04).
#
# The CSP is the app's whole network surface written down. Everything is
# same-origin — the graph artifacts, the .pmtiles basemaps, the glyphs and
# sprites, the fonts, /api/report — with exactly two exceptions:
#   - https://photon.komoot.io   search and reverse geocode (fetch only)
#   - pub-9f5d….r2.dev, tiles.napwalk.com   the overlay tiles, basemaps and border.json, when
#     (the exact bucket host, not *.r2.dev: anyone can register an r2.dev
#     name, so the wildcard was a CSP-legal exfil destination — review 2026-09-16)
#     VITE_TILE_BASE points at the public R2 bucket (docs/DEPLOY.md). With
#     the tiles served from Pages (VITE_TILE_BASE unset) that entry is
#     unused and can be deleted; with a custom tile domain, replace it with
#     that host rather than widening it.
# 'unsafe-inline' is in style-src because MapLibre injects inline styles for
# the canvas and its controls; script-src is 'self' plus the Umami host
# (a.viktoresadze.com, the owner's page counter, 2026-09-16) — index.html has no
# inline script. blob: is MapLibre's worker and its texture blobs.
# tile.openstreetmap.org is deliberately absent: the raster reference
# basemap is debug.html's, and debug.html is not in the production build.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://a.viktoresadze.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://photon.komoot.io https://pub-9f5d742c7f5c401f94721fa153f94c9f.r2.dev https://tiles.napwalk.com https://a.viktoresadze.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

# Content-addressed by the build stamp in their query string, so a year.
/graph*.bin.gz*
  Cache-Control: public, max-age=31536000, immutable

/graph*.bin.br*
  Cache-Control: public, max-age=31536000, immutable

# Vite writes the content hash into the filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Overlay tiles and border.json carry ?v=<TILE_VERSION>; the same one-year
# immutable header rclone puts on the R2 copies (docs/DEPLOY.md).
/tiles/*
  Cache-Control: public, max-age=31536000, immutable

# Basemaps and their glyphs/sprites have no cache-buster of their own: an
# hour fresh, a day stale-while-revalidate, so a redeploy is picked up the
# same day without refetching 14 MiB on every visit.
/basemap/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/basemap-assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The shell itself is what points at every hashed asset above: never cached.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# The artifact size manifest (scripts/cities-manifest.mjs) is regenerated by
# every build and carries no cache-buster of its own: it must not outlive a
# redeploy that reshaped the graphs.
/cities.json
  Cache-Control: no-cache
